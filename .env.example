DB_HOST=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
# Enable only on a separately reviewed development/test database.
DB_MIGRATIONS_ENABLED=false
# Base64 of at least 32 cryptographically random bytes; no default key.
JWT_SECRET_BASE64=
JWT_ISSUER=fashion-commerce
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=14d
# Comma-separated exact browser origins, e.g. http://localhost:3000
CORS_ALLOWED_ORIGINS=

