DB_HOST=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
# Enable only on a separately reviewed development/test database.
DB_MIGRATIONS_ENABLED=false
# Base64 of at least 32 cryptographically random bytes; no default key.
JWT_SECRET_BASE64=
JWT_ISSUER=fashion-commerce
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=14d
# Comma-separated exact browser origins, e.g. http://localhost:3000
CORS_ALLOWED_ORIGINS=
ASSET_PUBLIC_BASE_URL=
REDIS_URL=redis://localhost:6379
# Base64 of at least 32 random bytes. Must be distinct from JWT_SECRET_BASE64 in production.
OTP_PEPPER_BASE64=
OTP_TTL=5m
OTP_RESEND_COOLDOWN=60s
OTP_MAX_ATTEMPTS=5
OTP_DAILY_SEND_LIMIT=10
# Gmail address and a Google App Password (never use the normal account password).
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
# Optional; defaults to GMAIL_USERNAME.
GMAIL_FROM=

